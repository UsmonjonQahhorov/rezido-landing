# -----------------------------------------------------------------------------
# rezido-landing environment. Copy to .env.local (gitignored) and fill in.
#
# Every variable is optional and SERVER-SIDE ONLY: none is prefixed NEXT_PUBLIC_,
# so none is inlined into browser JavaScript. Pages are statically generated, so
# a change takes effect on the next build (or the next revalidation, at most
# five minutes, for pages that render listings).
# -----------------------------------------------------------------------------

# Canonical origin for metadata, Open Graph URLs, robots.txt and sitemap.xml.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL on Vercel, then http://localhost:3000.
SITE_URL=https://rezido.example

# Rezido REST API base URL, including /api/v1 and no trailing slash.
# Unset: the site shows its bundled demo listings, clearly labelled "Namuna".
# Set: listings come from GET /properties/ and /properties/{id}/ (public endpoints).
# Local backend (rezido-backend docker compose): http://localhost:8001/api/v1
REZIDO_API_URL=

# App store listings. Each button is rendered only when its URL is set.
APP_STORE_URL=
GOOGLE_PLAY_URL=

# Contact details for /contact. Nothing is shown until these are set.
CONTACT_EMAIL=
CONTACT_PHONE=

# Social profiles for the footer. Rendered only when set.
TELEGRAM_URL=
INSTAGRAM_URL=
